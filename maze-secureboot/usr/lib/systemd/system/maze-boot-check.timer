[Unit]
Description=Periodic Maze boot chain verification

[Timer]
# Once shortly after boot, then daily. Catches drift that happens outside any
# pacman transaction: a manual `bootctl update`, a hand-run mkinitcpio, someone
# editing the ESP directly.
OnBootSec=3min
OnUnitActiveSec=1d
Persistent=true

[Install]
WantedBy=timers.target
