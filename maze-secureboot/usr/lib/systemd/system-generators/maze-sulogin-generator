#!/bin/sh
# Managed by Maze Linux (maze-secureboot).
#
# Decides, on every boot, whether the emergency and rescue shells may open
# without a root password (SULOGIN_FORCE=1), and writes the drop-ins only when
# they may.
#
# WHY THERE IS A QUESTION AT ALL
#
# Maze locks root (the first user gets sudo). sulogin refuses a locked account,
# so without SULOGIN_FORCE the one moment a user needs a shell — a failed mount,
# a broken /etc/fstab — leaves a live USB as the only way in.
#
# This used to be two static drop-ins, justified by "the kernel command line is
# sealed in a signed UKI, so emergency mode cannot be requested at boot". That
# holds only while Secure Boot is ON. With it off — and on most machines anyone
# at the keyboard can turn it off in firmware setup — systemd-stub accepts a
# command line from whatever starts it, so `systemd.unit=emergency.target` is
# one boot entry away. A password-less shell is only safe when reaching it
# PROVES the person already knew the disk passphrase.
#
# THE RULE
#
#   SULOGIN_FORCE=1 only when the root file system is unlocked by the busybox
#   `encrypt` hook (cryptdevice= on the command line) with a passphrase: no
#   cryptkey= keyfile, no /crypto_keyfile.bin in the initramfs, and not the
#   systemd unlock path (rd.luks*), which can unlock from a TPM or token with
#   nobody typing anything. A disk that unlocks by itself proves nothing.
#
#   Anything else — an unencrypted disk included — keeps sulogin's default:
#   it asks for the root password, and with root locked the shell stays shut.
#
# Overrides (the admin's machine, the admin's call):
#   /etc/maze/sulogin-force   always allow the password-less shell
#   /etc/maze/sulogin-never   never allow it
#
# `maze-sulogin-generator --status` prints the decision and why (for
# maze-doctor / maze-audit); it writes nothing.
set -u

decide() {
    if [ -e /etc/maze/sulogin-never ]; then
        echo "off /etc/maze/sulogin-never is set"; return
    fi
    if [ -e /etc/maze/sulogin-force ]; then
        echo "on /etc/maze/sulogin-force is set"; return
    fi
    _cmd=" $(cat /proc/cmdline 2>/dev/null) "
    case "$_cmd" in
        *" rd.luks"*)
            echo "off root is unlocked by systemd (rd.luks), possibly without a passphrase"; return ;;
        *" cryptdevice="*) ;;
        *)
            echo "off root is not on a passphrase-unlocked LUKS volume"; return ;;
    esac
    case "$_cmd" in
        *" cryptkey="*)
            echo "off root is unlocked with a keyfile (cryptkey=)"; return ;;
    esac
    for _c in /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf; do
        [ -r "$_c" ] || continue
        if grep -qE '^[[:space:]]*FILES=\([^)]*crypto_keyfile' "$_c" 2>/dev/null; then
            echo "off the initramfs carries /crypto_keyfile.bin ($_c), so root unlocks without a passphrase"
            return
        fi
    done
    echo "on root is LUKS-encrypted and unlocked by passphrase"
}

if [ "${1:-}" = "--status" ]; then
    decide
    exit 0
fi

out="${1:-}"
[ -n "$out" ] && [ -d "$out" ] || exit 0

verdict="$(decide)"
case "$verdict" in
    on\ *) ;;
    *) exit 0 ;;
esac

for unit in emergency rescue; do
    mkdir -p "$out/$unit.service.d" 2>/dev/null || continue
    cat > "$out/$unit.service.d/10-maze-sulogin.conf" 2>/dev/null <<EOF
# Generated by maze-sulogin-generator: ${verdict#on }.
[Service]
Environment=SULOGIN_FORCE=1
EOF
done
exit 0
