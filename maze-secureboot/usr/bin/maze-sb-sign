#!/bin/sh
# Managed by Maze Linux. Signs the kernel-install-built Unified Kernel Image
# (layout=uki) that shim chainloads as grubx64.efi. Idempotent.
# Usage: maze-sb-sign [ESP_MOUNTPOINT] [--force-bootloader] [--retry-shim]
#   --force-bootloader  re-sign grubx64.efi even when it is already current
#                       (repair); without it an up-to-date image is left alone.
#   --retry-shim        forget that a packaged shim failed its trial boot and
#                       offer it again (see "Which shim goes on the ESP").
set -eu

KEYDIR=/var/lib/maze-secureboot
KEY="$KEYDIR/MOK.key"
CRT="$KEYDIR/MOK.crt"
CER="$KEYDIR/MOK.cer"

# --- Which UKIs may be signed at all ----------------------------------------
# The ESP is an unencrypted FAT partition: anyone with the disk in hand can drop
# a file into EFI/Linux, or edit the UKI already there (swap its initrd). This
# script runs on every boot and on every change to that directory, and it used
# to sign EVERY *.efi it found there — including a modified UKI, whose broken
# signature simply made it "need signing" — and then installed it as
# grubx64.efi. That turned the MOK key into a signing service for whoever could
# write to the ESP, i.e. a full Secure Boot bypass.
#
# Neither the file name nor the PE .uname section helps: both are written by
# the same person who wrote the file. The only trustworthy witness is the moment
# the UKI is BUILT. 85-maze-sb-trust.install runs inside `kernel-install add`,
# after ukify has produced the image in kernel-install's private staging
# directory and before 90-uki-copy.install copies it to the ESP, and records
# its sha256 and kernel version here — on the root filesystem, next to the key,
# where an attacker who cannot read the key cannot write either.
#
# A UKI is signed only when its exact bytes are in this list AND its kernel is
# installed (/usr/lib/modules/<kver>/vmlinuz). Anything else is reported and
# left alone — never signed, never deleted, never installed as grubx64.efi.
TRUST_DB="$KEYDIR/trusted-ukis"

# kernel-install's KERNEL_VERSION: a plain token, never a path or a field
# separator, since it ends up in the list above and in /usr/lib/modules/<kver>.
valid_kver() {
    case "$1" in
        ''|*/*|*[!A-Za-z0-9._+~-]*) return 1 ;;
    esac
    return 0
}

file_sha256() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }

# `maze-sb-sign --trust KVER FILE` — called only by 85-maze-sb-trust.install.
# Handled before the MOK key check on purpose: during installation the UKI is
# built (Calamares' bootloader module) before the per-machine key exists, and
# that build still has to be recognised when the key is made and the first
# signing run happens.
if [ "${1:-}" = "--trust" ]; then
    _tk="${2:-}"; _tf="${3:-}"
    if ! valid_kver "$_tk" || [ ! -f "$_tf" ]; then
        echo "maze-sb-sign: --trust needs a kernel version and an existing UKI" >&2
        exit 2
    fi
    _ts="$(file_sha256 "$_tf")"
    [ -n "$_ts" ] || { echo "maze-sb-sign: cannot hash $_tf" >&2; exit 1; }
    mkdir -p /run/lock
    exec 9>/run/lock/maze-sb-sign.lock
    flock 9
    # The key directory is root-only: the list says which images root's key
    # will sign, so no one else may extend it.
    ( umask 077; mkdir -p "$KEYDIR" )
    _tmp="$TRUST_DB.tmp.$$"
    # umask in the subshell that opens the file, so the list is created 0600.
    ( umask 077; exec > "$_tmp"
      # Keep at most the newest few builds per kernel: every kernel-install
      # adds one, and an image that was replaced by a newer build of the same
      # kernel has no business being signed later.
      if [ -r "$TRUST_DB" ]; then
          _n=0
          # Newest entries are at the bottom; walk them in reverse.
          sed -n '1!G;h;$p' "$TRUST_DB" | while read -r _s _k _rest; do
              [ -n "$_s" ] && [ -n "$_k" ] || continue
              [ "$_s" = "$_ts" ] && continue
              if [ "$_k" = "$_tk" ]; then
                  _n=$((_n + 1))
                  [ "$_n" -lt 3 ] || continue
              fi
              printf '%s %s\n' "$_s" "$_k"
          done | sed -n '1!G;h;$p'
      fi
      printf '%s %s\n' "$_ts" "$_tk"
    ) || { rm -f "$_tmp"; echo "maze-sb-sign: could not write $TRUST_DB" >&2; exit 1; }
    mv -f "$_tmp" "$TRUST_DB"
    echo "maze-sb-sign: trusted new UKI build for kernel $_tk"
    exit 0
fi

if [ ! -r "$KEY" ] || [ ! -r "$CRT" ]; then
    echo "maze-sb-sign: no MOK key, skipping" >&2; exit 0
fi

# --- Wait for a running pacman transaction (maze-sb-resign.service only) ----
# maze-sb-resign.path fires the moment ANY file in $ESP/EFI/Linux changes. In a
# pacman transaction that rebuilds more than one kernel, 85-maze-kernel-install
# writes the UKIs one after another, so the path unit starts this script after
# the first one lands — while the newest kernel's UKI is still being built. That
# run correctly refuses to touch grubx64.efi ("no trusted UKI for <kver>"), but
# it exits 1 and leaves a failed unit and a "Failed to start" line in the
# journal on every kernel update; 9 seconds later the next run, and the
# zz-maze-secureboot hook, sign everything. A false alarm on the one unit whose
# failures must be taken seriously.
#
# So when the SERVICE starts this while pacman holds its database lock, it waits
# for the transaction to finish and then signs the final state. The service
# asks for this with MAZE_SB_SIGN_DEFER=1; every other caller runs at once as
# before — and must: 95-maze-sb-sign.install, zz-maze-secureboot.hook and the
# package scriptlet run INSIDE the transaction, so waiting for pacman there
# would wait forever.
#
# Rules, each one so this can never make things worse than not waiting:
#   * Wait BEFORE taking the signer lock below. Holding it while waiting would
#     block the in-transaction signer (the hook) behind us — a deadlock.
#   * Only while a process really holds the lock open. libalpm keeps db.lck
#     open for the whole transaction; a lock left behind by a crashed pacman
#     has no holder, and pacman itself refuses to run until it is removed, so
#     signing now is right.
#   * Never during boot or shutdown: the service is also WantedBy
#     multi-user.target, and a oneshot that waits would hold up the boot.
#   * At most MAZE_SB_SIGN_DEFER_MAX seconds (default 4 h, a slow full
#     upgrade); after that, sign as before. A run that starts early can only
#     fail loudly and leave grubx64.efi alone, as it always did.
pacman_lockfile() {
    _pl_db="$(pacman-conf DBPath 2>/dev/null | head -n 1 || true)"
    case "$_pl_db" in
        /*) ;;
        *) _pl_db=/var/lib/pacman/ ;;
    esac
    printf '%s/db.lck\n' "${_pl_db%/}"
}

# True while some process has the lock file open (pacman, or any libalpm
# front-end). /proc is read directly; no psmisc dependency.
pacman_lock_held() {
    [ -e "$1" ] || return 1
    find /proc/[0-9]*/fd -maxdepth 1 -lname "$1" 2>/dev/null | grep -q .
}

wait_for_pacman() {
    _wp_lock="$(pacman_lockfile)"
    pacman_lock_held "$_wp_lock" || return 0
    case "$(systemctl is-system-running 2>/dev/null || true)" in
        initializing|starting|stopping) return 0 ;;
    esac
    _wp_max="${MAZE_SB_SIGN_DEFER_MAX:-14400}"
    case "$_wp_max" in ''|*[!0-9]*) _wp_max=14400 ;; esac
    echo "maze-sb-sign: a pacman transaction is running; signing once it has finished"
    _wp_waited=0
    while pacman_lock_held "$_wp_lock"; do
        if [ "$_wp_waited" -ge "$_wp_max" ]; then
            echo "maze-sb-sign: pacman still holds its lock after ${_wp_max}s; signing now" >&2
            return 0
        fi
        sleep 2
        _wp_waited=$((_wp_waited + 2))
    done
    echo "maze-sb-sign: pacman finished after ~${_wp_waited}s"
    return 0
}

if [ "${MAZE_SB_SIGN_DEFER:-0}" = 1 ]; then
    wait_for_pacman
fi

# Serialize all invocations. This script is triggered from up to three
# independent, overlapping sources for a single kernel update — the
# 85-maze-kernel-install.hook -> kernel-install add -> 95-maze-sb-sign.install
# plugin, the zz-maze-secureboot.hook (same pacman transaction), and the
# maze-sb-resign.path unit reacting to the new UKI file appearing under
# $ESP/EFI/Linux. Without a lock, two concurrent instances can both sign the
# same file to the same fixed temp name (sign_inplace's "$f.maze-signed" /
# the grubx64.efi temp below) and race each other's write, producing a
# truncated/corrupt result on disk. Confirmed in production: overlapping
# maze-sb-resign.service runs 0 seconds apart left a 63%-truncated UKI and a
# kernel panic ("No working init found") on next boot. The lock makes every
# invocation, regardless of trigger, run one at a time.
LOCKFILE=/run/lock/maze-sb-sign.lock
# /run/lock can be absent when /run is a fresh tmpfs (e.g. some chroot setups
# mount their own /run) — without this, exec 9> fails and set -eu aborts the
# whole signing run.
mkdir -p /run/lock
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    echo "maze-sb-sign: another instance is running, waiting..." >&2
    flock 9
fi

ESP=""
force_bootloader=0
retry_shim=0
for arg in "$@"; do
    case "$arg" in
        --force-bootloader) force_bootloader=1 ;;
        --retry-shim) retry_shim=1 ;;
        *) ESP="$arg" ;;
    esac
done

if [ -z "$ESP" ]; then
    ESP="$(bootctl --print-esp-path 2>/dev/null || true)"
    [ -n "${ESP:-}" ] && [ -d "$ESP" ] || ESP=/efi
    [ -d "$ESP" ] || ESP=/boot
fi
if [ ! -d "$ESP" ]; then
    echo "maze-sb-sign: ESP path '$ESP' does not exist" >&2
    exit 1
fi

status_ok=1

install_if_diff() {
    [ -f "$1" ] || return 0
    cmp -s "$1" "$2" 2>/dev/null && return 0
    install -m644 "$1" "$2"
}

sign_inplace() {
    f="$1"
    [ -e "$f" ] || return 0
    # In a subshell: sbverify can crash on a truncated image, and the shell's
    # own "Segmentation fault" notice would otherwise leak past the redirect.
    if (sbverify --cert "$CRT" "$f") >/dev/null 2>&1; then
        echo "maze-sb-sign: OK     $f"
        return 0
    fi
    # stderr is captured and shown only on failure: "FAIL" alone does not say
    # whether the ESP is full, the key unreadable or the image malformed.
    if _sberr="$(sbsign --key "$KEY" --cert "$CRT" --output "$f.maze-signed" "$f" 2>&1 >/dev/null)"; then
        mv -f "$f.maze-signed" "$f"
        echo "maze-sb-sign: SIGNED $f"
    else
        rm -f "$f.maze-signed"
        echo "maze-sb-sign: FAIL   $f" >&2
        [ -n "$_sberr" ] && printf '%s\n' "$_sberr" | sed 's/^/maze-sb-sign:   /' >&2
        status_ok=0
    fi
}

is_signed() { (sbverify --cert "$CRT" "$1") >/dev/null 2>&1; }

# Number of Authenticode signatures in a PE image (0 when unsigned).
signature_count() {
    (sbverify --list "$1") 2>/dev/null | grep -c '^signature [0-9]' || true
}

# Remove every signature, in place. sbattach --remove takes off one per call.
strip_signatures() {
    _ss_n=0
    while [ "$(signature_count "$1")" -gt 0 ]; do
        _ss_n=$((_ss_n + 1))
        [ "$_ss_n" -le 16 ] || return 1
        sbattach --remove "$1" >/dev/null 2>&1 || return 1
    done
    return 0
}

# Kernel version recorded for these exact bytes, if kernel-install built them
# on this machine. Prints nothing for an image nobody vouched for.
trusted_kver() {
    [ -r "$TRUST_DB" ] || return 0
    _tv_sum="$(file_sha256 "$1")"
    [ -n "$_tv_sum" ] || return 0
    while read -r _tv_s _tv_k _tv_rest; do
        if [ "$_tv_s" = "$_tv_sum" ] && valid_kver "$_tv_k"; then
            printf '%s\n' "$_tv_k"
            return 0
        fi
    done < "$TRUST_DB"
    return 0
}

kver_installed() { valid_kver "$1" && [ -f "/usr/lib/modules/$1/vmlinuz" ]; }

# May this UKI be booted / signed? Yes if our key already signed it (it was
# vetted when it was signed — and an edited image no longer verifies), or if it
# is a recorded build of a kernel that is installed. With a second argument,
# a recorded build must also be a build of THAT kernel version.
uki_acceptable() {
    [ -f "$1" ] || return 1
    is_signed "$1" && return 0
    _ua_k="$(trusted_kver "$1")"
    [ -n "$_ua_k" ] && kver_installed "$_ua_k" || return 1
    [ -z "${2:-}" ] || [ "$_ua_k" = "$2" ]
}

refused_any=0
# Sign a UKI only when uki_acceptable() says it is ours. Never deletes or
# changes anything it refuses, and a refusal never fails the run on its own:
# a file we did not make is not ours to judge beyond "do not sign it". (When
# the image we NEED is the one refused, the boot-image step below fails loudly
# instead, and leaves the working grubx64.efi in place.)
sign_uki() {
    _su_f="$1"
    [ -f "$_su_f" ] || return 0
    if is_signed "$_su_f"; then
        echo "maze-sb-sign: OK     $_su_f"
        return 0
    fi
    _su_k="$(trusted_kver "$_su_f")"
    if [ -z "$_su_k" ]; then
        echo "maze-sb-sign: REFUSED $_su_f" >&2
        echo "maze-sb-sign:   not a UKI kernel-install built on this machine (unknown or modified content) — not signing it" >&2
        refused_any=1
        return 0
    fi
    if ! kver_installed "$_su_k"; then
        echo "maze-sb-sign: REFUSED $_su_f (kernel $_su_k is not installed) — not signing it" >&2
        refused_any=1
        return 0
    fi
    sign_inplace "$_su_f"
}

# Drop list entries for kernels that are gone: their images are pruned below
# and must not become signable again if the same bytes reappear.
prune_trust_db() {
    [ -s "$TRUST_DB" ] || return 0
    _pt_tmp="$TRUST_DB.tmp.$$"
    if ( umask 077; exec > "$_pt_tmp"
         while read -r _pt_s _pt_k _pt_rest; do
             [ -n "$_pt_s" ] || continue
             kver_installed "$_pt_k" || continue
             printf '%s %s\n' "$_pt_s" "$_pt_k"
         done < "$TRUST_DB" ); then
        if cmp -s "$_pt_tmp" "$TRUST_DB"; then
            rm -f "$_pt_tmp"
        else
            mv -f "$_pt_tmp" "$TRUST_DB" || rm -f "$_pt_tmp"
        fi
    else
        rm -f "$_pt_tmp"
    fi
    return 0
}

# A loose kernel (vmlinuz-<pkgbase>, a type-1 entry's <token>/<kver>/linux) is
# signed only when it is byte-identical to a kernel a package installed under
# /usr/lib/modules — the same rule, with the package as the witness.
sign_loose_kernel() {
    _sl_f="$1"
    [ -f "$_sl_f" ] || return 0
    if is_signed "$_sl_f"; then
        echo "maze-sb-sign: OK     $_sl_f"
        return 0
    fi
    for _sl_m in /usr/lib/modules/*/vmlinuz; do
        [ -f "$_sl_m" ] || continue
        if cmp -s "$_sl_f" "$_sl_m"; then
            sign_inplace "$_sl_f"
            return 0
        fi
    done
    echo "maze-sb-sign: REFUSED $_sl_f (not identical to any installed kernel) — not signing it" >&2
    refused_any=1
    return 0
}

BOOTDIR="$ESP/EFI/BOOT"
mkdir -p "$BOOTDIR"

# --- Which shim goes on the ESP -----------------------------------------------
# The shim used to be copied off the install ISO into $KEYDIR ONCE and never
# again: every run put that same copy back on the ESP, and maze-boot-check
# compared against it. A shim-signed update therefore never reached an installed
# machine — and the day a firmware or fwupd update revokes that shim generation
# (SBAT), every Maze machine with Secure Boot on stops booting at once.
#
# The packaged shim (/usr/share/shim-signed, kept current by pacman) is now the
# CANDIDATE, and $KEYDIR/shimx64.efi changes meaning: it is the LAST KNOWN GOOD
# shim — one that has booted this machine with Secure Boot on. A new shim is
# never trusted on its word, because a shim update is riskier than a kernel
# update: the new shim writes its own revocations into firmware (SbatLevel) the
# first time it runs, which can never be undone from the OS.
#
#   1. Checks before it is used at all: Microsoft-signed; its shim generation
#      not revoked by this firmware (SbatLevelRT); not older than the last
#      known good; and the revocations it would apply do not revoke the
#      systemd-stub our UKIs are built on (that would brick both chains).
#   2. Trial: it goes into EFI/BOOT only. EFI/maze-recovery keeps the last known
#      good shim, so a shim that fails still leaves a firmware-menu way back.
#   3. Promotion: after a reboot that came up WITH Secure Boot on THROUGH the
#      primary chain (systemd-stub's StubImageIdentifier says which image it
#      started), it becomes the last known good and the recovery chain follows.
#   4. Rejection: if that reboot came up through the recovery chain instead,
#      the new shim is assumed to have failed: it is recorded as rejected and
#      the last known good goes back into EFI/BOOT. `--retry-shim` forgets that.
#
# Exception: when the last known good is itself revoked (by the firmware, or by
# the candidate's own revocation policy) keeping it anywhere protects nothing —
# it cannot boot with Secure Boot on — so the candidate goes everywhere at once.
SHIM_PKG=/usr/share/shim-signed/shimx64.efi
MM_PKG=/usr/share/shim-signed/mmx64.efi
SHIM_LKG="$KEYDIR/shimx64.efi"
MM_LKG="$KEYDIR/mmx64.efi"
SHIM_PENDING="$KEYDIR/shim-pending"     # "<sha256> <boot_id>" of the shim on trial
SHIM_REJECTED="$KEYDIR/shim-rejected"   # sha256 per line: shims that failed a trial
SBAT_GUID=605dab50-e046-4300-abb6-3dd810dd8b23
LOADER_GUID=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

# An EFI variable's payload as text: drop the 4 attribute bytes and the NULs of
# UTF-16 (the variables read here are ASCII).
efivar_text() {
    [ -r "/sys/firmware/efi/efivars/$1" ] || return 1
    tail -c +5 "/sys/firmware/efi/efivars/$1" 2>/dev/null | tr -d '\0'
}

# "component,generation" lines of a PE image's .sbat section.
sbat_lines() {
    objcopy -O binary --only-section=.sbat "$1" /dev/stdout 2>/dev/null \
        | tr -d '\0' | awk -F, 'NF >= 2 && $2 ~ /^[0-9]+$/ { print $1 "," $2 }'
}
sbat_gen() { sbat_lines "$1" | awk -F, -v c="$2" '$1 == c { print $2; exit }'; }

# Vendor version of a shim (e.g. 16.1-1): the highest version field among the
# .sbat lines whose product is "shim".
shim_version() {
    objcopy -O binary --only-section=.sbat "$1" /dev/stdout 2>/dev/null \
        | tr -d '\0' | awk -F, '$4 == "shim" { print $5 }' | sort -V | tail -1
}

# Revocations the RUNNING firmware enforces ("component,min-generation").
fw_revocations() { efivar_text "SbatLevelRT-$SBAT_GUID" | awk -F, 'NF == 2 { print $1 "," $2 }'; }

# Revocations a shim applies by itself on its first run: the "previous" policy
# of its .sbatlevel section (u32 version, u32 offset of previous, u32 offset of
# latest — offsets counted from byte 4; each policy a NUL-terminated string).
shim_applies() {
    _sa_tmp="$(mktemp /run/maze-sbatlevel.XXXXXX 2>/dev/null)" || return 0
    if objcopy -O binary --only-section=.sbatlevel "$1" "$_sa_tmp" 2>/dev/null && [ -s "$_sa_tmp" ]; then
        _sa_off="$(od -An -tu4 -j4 -N4 "$_sa_tmp" 2>/dev/null | tr -d '[:space:]')"
        case "$_sa_off" in ''|*[!0-9]*) _sa_off="" ;; esac
        if [ -n "$_sa_off" ]; then
            tail -c +"$((_sa_off + 5))" "$_sa_tmp" | tr '\0' '\n' \
                | awk -F, '/^$/ { exit } NF == 2 && $2 ~ /^[0-9]+$/ { print $1 "," $2 }'
        fi
    fi
    rm -f "$_sa_tmp"
}

# Would REVOCATIONS (stdin, "component,min") revoke image FILE? Prints the
# first offending "component gen<min", exits 0 when it would.
revokes() { # file
    _rv_have="$(sbat_lines "$1")"
    while IFS=, read -r _rv_c _rv_min; do
        [ "$_rv_c" = sbat ] && continue
        _rv_g="$(printf '%s\n' "$_rv_have" | awk -F, -v c="$_rv_c" '$1 == c { print $2; exit }')"
        [ -n "$_rv_g" ] || continue
        if [ "$_rv_g" -lt "$_rv_min" ]; then
            printf '%s %s<%s\n' "$_rv_c" "$_rv_g" "$_rv_min"
            return 0
        fi
    done
    return 1
}

ms_signed() { (sbverify --list "$1") 2>/dev/null | grep -q 'O=Microsoft Corporation'; }
boot_id() { tr -d '[:space:]' < /proc/sys/kernel/random/boot_id 2>/dev/null || true; }
sb_on() {
    # SecureBoot-8be4df61-...: 4 attribute bytes, then 1 byte (1 = enabled).
    [ "$(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null \
          | tr -d '[:space:]')" = 1 ]
}
# Which image systemd-stub was started as on this boot, lower-cased, e.g.
# \efi\boot\grubx64.efi. Empty when the stub did not say.
# shellcheck disable=SC1003  # '\\' is tr's literal backslash, not an escaped quote
booted_image() { efivar_text "StubImageIdentifier-$LOADER_GUID" | tr 'A-Z/' 'a-z\\'; }

# Copy into place by rename, so a half-written shim never sits on the ESP.
install_atomic() { # src dst
    [ -f "$1" ] || return 0
    cmp -s "$1" "$2" 2>/dev/null && return 0
    if cp -f "$1" "$2.maze-new" && mv -f "$2.maze-new" "$2"; then return 0; fi
    rm -f "$2.maze-new"
    return 1
}

# Make the candidate the last known good (and the source of the recovery chain).
promote_shim() {
    ( umask 077
      cp -f "$SHIM_PKG" "$SHIM_LKG.tmp" && mv -f "$SHIM_LKG.tmp" "$SHIM_LKG" ) || return 1
    if [ -f "$MM_PKG" ]; then
        ( umask 077; cp -f "$MM_PKG" "$MM_LKG.tmp" && mv -f "$MM_LKG.tmp" "$MM_LKG" ) || true
    fi
    rm -f "$SHIM_PENDING"
}

[ "$retry_shim" = 0 ] || { rm -f "$SHIM_REJECTED"; echo "maze-sb-sign: forgot rejected shims; the packaged shim is offered again"; }

# The shim that goes into EFI/BOOT; the recovery chain always uses $SHIM_LKG.
SHIM_PRIMARY="$SHIM_LKG"
MM_PRIMARY="$MM_LKG"

shim_candidate_ok() {
    [ -s "$SHIM_PKG" ] || return 1
    [ -s "$SHIM_LKG" ] || return 0      # nothing better to compare with
    _cs="$(file_sha256 "$SHIM_PKG")"
    [ "$_cs" != "$(file_sha256 "$SHIM_LKG")" ] || return 1
    if grep -qx "$_cs" "$SHIM_REJECTED" 2>/dev/null; then
        echo "maze-sb-sign: packaged shim $(shim_version "$SHIM_PKG") failed its trial boot here earlier; keeping the last known good (retry: sudo maze-sb-sign --retry-shim)" >&2
        return 1
    fi
    if ! ms_signed "$SHIM_PKG"; then
        echo "maze-sb-sign: WARNING - $SHIM_PKG carries no Microsoft signature; not using it" >&2
        return 1
    fi
    _cg="$(sbat_gen "$SHIM_PKG" shim)"; _lg="$(sbat_gen "$SHIM_LKG" shim)"
    case "$_cg" in ''|*[!0-9]*)
        echo "maze-sb-sign: WARNING - cannot read the SBAT generation of $SHIM_PKG; not using it" >&2
        return 1 ;;
    esac
    _r="$(fw_revocations | revokes "$SHIM_PKG" || true)"
    if [ -n "$_r" ]; then
        echo "maze-sb-sign: WARNING - packaged shim is revoked by this firmware ($_r); not using it" >&2
        return 1
    fi
    case "$_lg" in ''|*[!0-9]*) _lg=0 ;; esac
    _cv="$(shim_version "$SHIM_PKG")"; _lv="$(shim_version "$SHIM_LKG")"
    if [ "$_cg" -lt "$_lg" ] || { [ -n "$_lv" ] && [ -n "$_cv" ] \
            && [ "$(printf '%s\n%s\n' "$_cv" "$_lv" | sort -V | head -1)" != "$_lv" ]; }; then
        return 1                         # older than what already boots: never downgrade
    fi
    # The revocations it would write must not revoke our own boot image.
    for _img in "$BOOTDIR/grubx64.efi" /usr/lib/systemd/boot/efi/linuxx64.efi.stub; do
        [ -f "$_img" ] || continue
        _r="$(shim_applies "$SHIM_PKG" | revokes "$_img" || true)"
        if [ -n "$_r" ]; then
            echo "maze-sb-sign: WARNING - packaged shim $_cv would revoke ${_img##*/} ($_r); keeping shim $_lv until systemd is updated" >&2
            return 1
        fi
    done
    return 0
}

# No stored shim at all (lost, or an install that never copied one): the
# packaged one is all there is.
if [ ! -s "$SHIM_LKG" ] && [ -s "$SHIM_PKG" ] && ms_signed "$SHIM_PKG"; then
    promote_shim && echo "maze-sb-sign: no stored shim — using the packaged shim $(shim_version "$SHIM_LKG")"
fi

if [ -s "$SHIM_PKG" ] && [ -s "$SHIM_LKG" ] && ! cmp -s "$SHIM_PKG" "$SHIM_LKG"; then
    _pkg_sum="$(file_sha256 "$SHIM_PKG")"
    _pend_sum=""; _pend_boot=""
    [ -r "$SHIM_PENDING" ] && read -r _pend_sum _pend_boot _ < "$SHIM_PENDING" 2>/dev/null || true

    # Settle a trial that has seen a reboot.
    if [ -n "$_pend_sum" ] && [ "$_pend_boot" != "$(boot_id)" ] && sb_on; then
        # shellcheck disable=SC1003  # the patterns are literal EFI paths with backslashes
        case "$(booted_image)" in
            *'\efi\boot\grubx64.efi')
                if [ "$_pend_sum" = "$_pkg_sum" ] && promote_shim; then
                    echo "maze-sb-sign: shim $(shim_version "$SHIM_LKG") booted this machine with Secure Boot on — it is now the last known good"
                fi ;;
            *'\efi\maze-recovery\'*)
                printf '%s\n' "$_pend_sum" >> "$SHIM_REJECTED"
                rm -f "$SHIM_PENDING"
                echo "maze-sb-sign: WARNING - this boot came through the RECOVERY chain while a new shim was on trial." >&2
                echo "maze-sb-sign:   Assuming the new shim failed: going back to the last known good one." >&2
                echo "maze-sb-sign:   If the new shim was not the problem: sudo maze-sb-sign --retry-shim" >&2 ;;
        esac
    fi
    # The package moved on while a trial was running: that trial is void.
    if [ -r "$SHIM_PENDING" ] && [ "$_pend_sum" != "$_pkg_sum" ]; then
        rm -f "$SHIM_PENDING"
    fi

    if ! cmp -s "$SHIM_PKG" "$SHIM_LKG" && shim_candidate_ok; then
        # Is the last known good dead anyway? Then there is nothing to protect.
        _dead="$(fw_revocations | revokes "$SHIM_LKG" || true)"
        [ -n "$_dead" ] || _dead="$(shim_applies "$SHIM_PKG" | revokes "$SHIM_LKG" || true)"
        if [ -n "$_dead" ]; then
            if promote_shim; then
                echo "maze-sb-sign: installed shim $(shim_version "$SHIM_LKG") everywhere (the previous shim is revoked: $_dead)"
            fi
        else
            SHIM_PRIMARY="$SHIM_PKG"
            [ -f "$MM_PKG" ] && MM_PRIMARY="$MM_PKG"
            if ! cmp -s "$SHIM_PKG" "$BOOTDIR/BOOTX64.EFI" 2>/dev/null || [ ! -r "$SHIM_PENDING" ]; then
                ( umask 077; printf '%s %s\n' "$_pkg_sum" "$(boot_id)" > "$SHIM_PENDING" ) || true
                echo "maze-sb-sign: shim $(shim_version "$SHIM_PKG") is on trial in EFI/BOOT; the recovery entry keeps shim $(shim_version "$SHIM_LKG") until it has booted this machine"
            fi
        fi
    fi
elif [ -r "$SHIM_PENDING" ]; then
    rm -f "$SHIM_PENDING"               # package and last known good agree again
fi

# Shim and MokManager are a pair: both from the same source.
if install_atomic "$SHIM_PRIMARY" "$BOOTDIR/BOOTX64.EFI"; then :; else
    echo "maze-sb-sign: FAIL   could not install shim as $BOOTDIR/BOOTX64.EFI" >&2
    status_ok=0
fi
install_atomic "$MM_PRIMARY" "$BOOTDIR/mmx64.efi" || true
install_if_diff "$CER" "$ESP/MOK.cer"

# --- Sign the UKI and install as grubx64.efi (shim's second stage) ---
# /etc/kernel/install.conf ships `layout=uki`, so `kernel-install add` (run by
# Calamares' bootloader module, and again below by deploy-to-target.sh) already
# built a real UKI (kernel + initramfs + /etc/kernel/cmdline + systemd PE stub,
# via kernel-install's own ukify plugin) at $ESP/EFI/Linux/<machine-id>-<kver>.efi.
# No manual `ukify build` needed here — just sign that file and install it as
# grubx64.efi, the exact name shim chainloads. This makes the boot chain
# portable across ALL UEFI firmware (shim verifies its second stage via
# shim_lock/MOK, never via db).
GRUB="$BOOTDIR/grubx64.efi"

# --- Choose the UKI by INSTALLED KERNEL VERSION, never by mtime ------------
# This used to be `ls -t "$ESP"/EFI/Linux/*.efi | head -1`, i.e. "whichever file
# is newest". That is wrong in precisely the case that matters. On a kernel
# upgrade pacman DELETES /usr/lib/modules/<old>, but nothing removes the old
# kernel's UKI from the ESP (kernel-install remove is never invoked for an Arch
# kernel upgrade, and mkinitcpio's remove hook only deletes what the preset
# lists — loose /boot images, never $ESP/EFI/Linux/*.efi). So the ESP keeps a
# UKI for a kernel that has no modules on disk. If `kernel-install add` for the
# NEW kernel then fails — or an older UKI simply gets a fresher mtime from the
# re-sign pass below — the mtime rule hands that dead kernel to shim as
# grubx64.efi and every layer reports success. The machine boots a kernel that
# cannot load a single module: vfat never comes up, /boot cannot be mounted,
# and there is no error message anywhere to explain it.
#
# Selecting by version removes the guesswork, and the modules-on-disk check
# below turns the silent brick into a loud, actionable failure.

# Newest kernel that has both modules and an image on disk.
newest_kver() {
    for _d in /usr/lib/modules/*/; do
        [ -f "${_d}vmlinuz" ] || continue
        _k="${_d%/}"
        printf '%s\n' "${_k##*/}"
    done | sort -V | tail -1
}

# uname-style version directory for an installed pkgbase (linux, linux-lts, …).
kver_for_pkgbase() {
    for _p in /usr/lib/modules/*/pkgbase; do
        [ -r "$_p" ] || continue
        [ "$(cat "$_p")" = "$1" ] || continue
        _d="${_p%/pkgbase}"
        [ -f "$_d/vmlinuz" ] || continue
        _d="${_d%/}"
        printf '%s\n' "${_d##*/}"
        return 0
    done
    return 1
}

# The kernel-install UKI for a version, named <entry-token>-<kver>.efi. If the
# filename does not match (a custom entry_token, a hand-copied image) read the
# version out of the PE .uname section.
#
# Name and .uname only FIND candidates — anyone who can write to the ESP can set
# both. A candidate is returned only if uki_acceptable() vouches for it, so a
# planted "<x>-<kver>.efi" can neither become the boot image nor shadow the
# real one (it used to win simply by sorting first). No acceptable image means
# "no UKI", which every caller already handles without touching grubx64.efi.
uki_uname() {
    objcopy -O binary --only-section=.uname "$1" /dev/stdout 2>/dev/null \
        | tr -d '\0' | tr -d '[:space:]'
}
find_uki() {
    _want="$1"
    for _f in "$ESP"/EFI/Linux/*"$_want".efi; do
        [ -f "$_f" ] || continue
        # A name match whose .uname says another kernel is a renamed image.
        if command -v objcopy >/dev/null 2>&1; then
            _u="$(uki_uname "$_f")"
            [ -z "$_u" ] || [ "$_u" = "$_want" ] || continue
        fi
        uki_acceptable "$_f" "$_want" && { printf '%s\n' "$_f"; return 0; }
    done
    command -v objcopy >/dev/null 2>&1 || return 1
    for _f in "$ESP"/EFI/Linux/*.efi; do
        [ -f "$_f" ] || continue
        _u="$(uki_uname "$_f")"
        [ "$_u" = "$_want" ] || continue
        uki_acceptable "$_f" "$_want" && { printf '%s\n' "$_f"; return 0; }
    done
    return 1
}

# --- Which kernel becomes the boot image? ----------------------------------
# /etc/maze/kernel-default holds the pkgbase the user pinned with the kernel
# switcher (`maze-kernel-helper set-default`). Honour it.
#
# This script used to ignore that file and always take the newest kernel, so
# installing or updating ANY kernel silently threw the user's choice away — the
# switcher had to print a "you will have to pin it again" warning after every
# single set-default. Someone who deliberately ran linux-lts was moved back onto
# linux by the next update, with no notice at boot.
#
# The pin is ADVISORY and can never leave the machine without a boot image: it
# is honoured only when that kernel is installed AND already has a UKI on the
# ESP. Anything else falls back to the newest installed kernel and says so.
PINNED_PKGBASE=""
if [ -r /etc/maze/kernel-default ]; then
    PINNED_PKGBASE="$(tr -d '[:space:]' < /etc/maze/kernel-default 2>/dev/null || true)"
fi

NEWEST_KVER="$(newest_kver)"
TARGET_KVER=""
UKI=""

if [ -n "$PINNED_PKGBASE" ]; then
    TARGET_KVER="$(kver_for_pkgbase "$PINNED_PKGBASE" || true)"
    if [ -z "$TARGET_KVER" ]; then
        echo "maze-sb-sign: pinned kernel '$PINNED_PKGBASE' is not installed — using the newest instead" >&2
    else
        UKI="$(find_uki "$TARGET_KVER" || true)"
        if [ -z "$UKI" ]; then
            echo "maze-sb-sign: pinned kernel '$PINNED_PKGBASE' ($TARGET_KVER) has no UKI on the ESP — using the newest instead" >&2
            TARGET_KVER=""
        else
            echo "maze-sb-sign: boot default pinned to '$PINNED_PKGBASE' ($TARGET_KVER)"
        fi
    fi
fi

if [ -z "$TARGET_KVER" ]; then
    TARGET_KVER="$NEWEST_KVER"
    if [ -n "$TARGET_KVER" ]; then
        UKI="$(find_uki "$TARGET_KVER" || true)"
    fi
fi

# --- Never hand shim a kernel the NVIDIA driver did not build for ----------
# nvidia-utils blacklists nouveau unconditionally (/usr/lib/modprobe.d/
# nvidia-utils.conf). A kernel DKMS could not build the nvidia module for
# therefore comes up with NO driver for the card: a black screen on a desktop
# whose monitor hangs off it, a dead dGPU on a hybrid laptop. It happens on an
# ordinary `pacman -Syu` — a new kernel lands before NVIDIA supports it (615 on
# kernel 7.2) — and maze-gpu-driver, which knows how to pin around it, never
# runs then. This runs at the end of every such transaction (after the 70-dkms
# hooks), so it is the one place that can keep the machine booting into a
# working display without the user doing anything.
#
# The fallback is TRANSIENT, not a pin: nothing is written to
# /etc/maze/kernel-default. Every later run starts from the normal choice again,
# so the moment the module exists for the new kernel (Arch's nvidia-open
# rebuild, or a DKMS build) the machine moves onto it by itself.
# maze-boot-check reports the fallback while it is active.
nv_module_for() { modinfo -k "$1" -n nvidia >/dev/null 2>&1; }
if [ -n "$TARGET_KVER" ] && [ -f /usr/lib/modprobe.d/nvidia-utils.conf ] \
   && command -v modinfo >/dev/null 2>&1 && ! nv_module_for "$TARGET_KVER"; then
    _nv_alt=""
    for _k in $(for _d in /usr/lib/modules/*/; do
                    [ -f "${_d}vmlinuz" ] || continue
                    _d="${_d%/}"; printf '%s\n' "${_d##*/}"
                done | sort -rV); do
        [ "$_k" = "$TARGET_KVER" ] && continue
        nv_module_for "$_k" || continue
        _nv_uki="$(find_uki "$_k" || true)"
        [ -n "$_nv_uki" ] || continue
        _nv_alt="$_k"
        break
    done
    if [ -n "$_nv_alt" ]; then
        echo "maze-sb-sign: WARNING - the NVIDIA driver is not built for kernel $TARGET_KVER." >&2
        echo "maze-sb-sign:   Booting $_nv_alt (driver built) instead, so the display keeps working." >&2
        echo "maze-sb-sign:   This switches back to $TARGET_KVER by itself once its module exists (the next nvidia-open update, or a DKMS build)." >&2
        TARGET_KVER="$_nv_alt"
        UKI="$_nv_uki"
    else
        echo "maze-sb-sign: WARNING - the NVIDIA driver is not built for kernel $TARGET_KVER, and no other" >&2
        echo "maze-sb-sign:   kernel has both the driver and a boot image. nouveau is blacklisted, so the" >&2
        echo "maze-sb-sign:   card will have NO driver after a reboot." >&2
        echo "maze-sb-sign:   sudo maze-gpu-driver --open   switches back to the open-source driver." >&2
    fi
fi

if [ -z "$TARGET_KVER" ]; then
    echo "maze-sb-sign: ERROR - no installed kernel found under /usr/lib/modules" >&2
    status_ok=0
fi

# --- Remove UKIs whose kernel is no longer installed -----------------------
# Nothing else on the system does this, so without it every kernel version ever
# installed leaves a ~90 MB image behind on a 3 GB ESP, and those stale files
# are exactly what the old mtime rule used to pick. Guarded three ways: there
# must be an image we are keeping, never the one we are about to install, and
# only names that parse as a kernel version with no /usr/lib/modules/<kver>
# directory — so every INSTALLED kernel keeps its UKI (that is what makes a
# second kernel, and the switcher's pin above, work at all).
prune_stale_ukis() {
    [ -n "$UKI" ] || return 0
    for _f in "$ESP"/EFI/Linux/*.efi; do
        [ -f "$_f" ] || continue
        [ "$_f" = "$UKI" ] && continue
        _b="${_f##*/}"; _b="${_b%.efi}"
        _kv="${_b#*-}"
        case "$_kv" in
            [0-9]*.[0-9]*) ;;
            *) continue ;;
        esac
        [ -d "/usr/lib/modules/$_kv" ] && continue
        if rm -f "$_f"; then
            echo "maze-sb-sign: removed stale UKI ${_b}.efi (kernel $_kv is not installed)"
        fi
    done
    # Never leak the loop's last exit status: `set -e` is in force and both call
    # sites are the final command of an `if` body, which is NOT a protected
    # context — a stray non-zero here would abort the run before signing.
    return 0
}

# Prune BEFORE signing as well as after. The after-only prune meant a run that
# kept failing could never reclaim the space causing the failure — and a full
# ESP is the obvious way for sbsign to fail, so the one situation the cleanup
# existed for was the one where it never ran. Doing it first is safe for exactly
# the reason the after-prune was: the grubx64.efi already on disk is a
# self-contained copy of a bootable UKI, so it survives whatever happens next.
if [ -s "$GRUB" ]; then
    prune_stale_ukis
fi

# --- Sign the UKIs themselves first -----------------------------------------
# grubx64.efi is made FROM the UKI, so sign the UKI before copying it. Signing it
# afterwards (in the safety-net loop at the end) changed the UKI's bytes after
# the copy, which made every following run see a "new" UKI and rewrite
# grubx64.efi again.
#
# Only images uki_acceptable() vouches for — a build kernel-install made here,
# of a kernel that is installed. Everything else is reported and left alone.
prune_trust_db
for _f in "$ESP"/EFI/Linux/*.efi; do
    sign_uki "$_f"
done

# --- Is grubx64.efi already current? ---------------------------------------
# This script runs on every boot (maze-sb-resign.service) and up to three times
# per kernel update. It used to re-sign and rewrite the ~45 MB grubx64.efi — the
# one file shim boots — on every one of those runs, even when nothing had
# changed: needless writes to a FAT filesystem that has no journal, of the most
# important file on it, most of them during early boot. Now it is rewritten only
# when its source UKI changed (sha256 recorded in grubx64.efi.maze-src), when the
# kernel changed, when its signature no longer verifies, or on
# --force-bootloader.
GRUB_SRC="$GRUB.maze-src"
UKI_SUM=""
[ -n "$UKI" ] && UKI_SUM="$(sha256sum "$UKI" 2>/dev/null | cut -d' ' -f1)"
grub_is_current() {
    [ "$force_bootloader" = 0 ] || return 1
    [ -n "$UKI_SUM" ] && [ -s "$GRUB" ] || return 1
    [ "$(tr -d '[:space:]' < "$GRUB_SRC" 2>/dev/null || true)" = "$UKI_SUM" ] || return 1
    [ "$(tr -d '[:space:]' < "$GRUB.maze-kver" 2>/dev/null || true)" = "$TARGET_KVER" ] || return 1
    # The markers describe what was written, not what is there now: a hand
    # copy (e.g. restoring grubx64.efi.maze-prev) leaves them stale. Read the
    # kernel version out of the image itself before trusting them.
    if command -v objcopy >/dev/null 2>&1; then
        _gu="$(objcopy -O binary --only-section=.uname "$GRUB" /dev/stdout 2>/dev/null \
                | tr -d '\0' | tr -d '[:space:]')"
        [ -z "$_gu" ] || [ "$_gu" = "$TARGET_KVER" ] || return 1
    fi
    (sbverify --cert "$CRT" "$GRUB") >/dev/null 2>&1
}

if [ -n "$UKI" ] && ! uki_acceptable "$UKI" "$TARGET_KVER"; then
    # Unreachable in practice — find_uki only returns a vouched-for image — but
    # grubx64.efi is made by signing a COPY of $UKI, so this one check is what
    # keeps it from ever being built out of something nobody vouched for. Even
    # if the in-place signing above failed (ESP full), a vouched-for image still
    # passes here, so a new kernel is never held back by that alone.
    echo "maze-sb-sign: ERROR - $UKI is not a trusted image for kernel $TARGET_KVER; leaving $GRUB unchanged" >&2
    status_ok=0
elif [ -n "$UKI" ] && grub_is_current; then
    echo "maze-sb-sign: OK     $GRUB (kernel $TARGET_KVER, unchanged)"
elif [ -n "$UKI" ]; then
    # Sign to a temp file and rename into place — never write $GRUB directly.
    # sbsign dying partway (disk full, killed mid-transaction) must not leave
    # a truncated/corrupt grubx64.efi with no working fallback, since it is the
    # ONLY thing shim chainloads.
    #
    # Sign a copy with its existing signatures stripped. sbsign does not
    # replace a signature, it APPENDS one, so signing the (already signed) UKI
    # gave grubx64.efi two signatures — and after a key rotation
    # (maze-sb-rotate-key) the first of them would be the retired key's, which
    # a shim that checks only the first signature rejects. The stripped copy
    # lives on the root filesystem, not the ESP, so it costs no ESP space; if
    # it cannot be made, sign the UKI as before.
    _grub_src="$UKI"
    _strip_tmp=""
    if signature_count "$UKI" | grep -q '^[1-9]' \
       && _strip_tmp="$(mktemp /var/tmp/maze-sb-sign.XXXXXX 2>/dev/null)"; then
        if cp -f "$UKI" "$_strip_tmp" 2>/dev/null && strip_signatures "$_strip_tmp"; then
            _grub_src="$_strip_tmp"
        fi
    fi
    if _sberr="$(sbsign --key "$KEY" --cert "$CRT" --output "$GRUB.maze-signed" "$_grub_src" 2>&1 >/dev/null)"; then
        [ -z "$_strip_tmp" ] || rm -f "$_strip_tmp"
        # Keep the OUTGOING image as grubx64.efi.maze-prev. shim chainloads
        # grubx64.efi and nothing else — there is no systemd-boot menu and the
        # sd-boot NVRAM entry is deliberately removed — so until now a kernel
        # that booted badly left no way back except a live USB. This is that way
        # back (see the recovery note printed at the end of the run).
        #
        # Rotate on a KERNEL VERSION change only, tracked in .maze-kver: this
        # script runs up to three times per kernel upgrade, and rotating on every
        # run would overwrite the fallback with the very image it is a fallback
        # for. maze-kernel-helper writes the same marker when it pins a kernel.
        #
        # ONLY while the outgoing kernel is still installed. On an ordinary
        # upgrade of the same kernel package (linux X -> linux Y) pacman has
        # already deleted /usr/lib/modules/X by the time this runs, so a copy of
        # the old image would be exactly the "boots, loads no module" brick
        # described above — and it would be advertised as the way back. It stays
        # useful when switching between two INSTALLED kernels (linux <->
        # linux-lts via maze-kernel-helper, or the pin falling back).
        _prev_kver=""
        if [ -r "$GRUB.maze-kver" ]; then
            _prev_kver="$(tr -d '[:space:]' < "$GRUB.maze-kver" 2>/dev/null || true)"
        fi
        if [ -s "$GRUB" ] && [ -n "$_prev_kver" ] && [ "$_prev_kver" != "$TARGET_KVER" ] \
           && [ -f "/usr/lib/modules/$_prev_kver/vmlinuz" ]; then
            if cp -f "$GRUB" "$GRUB.maze-prev" 2>/dev/null; then
                printf '%s\n' "$_prev_kver" > "$GRUB.maze-prev.kver" 2>/dev/null || true
                echo "maze-sb-sign: kept kernel $_prev_kver as ${GRUB}.maze-prev (rollback copy)"
            else
                # Out of space on the ESP is the realistic failure here. A partial
                # copy would waste that space AND look like a usable fallback to
                # whoever finds it later, so remove both it and its stale label.
                rm -f "$GRUB.maze-prev" "$GRUB.maze-prev.kver" 2>/dev/null || true
                echo "maze-sb-sign: WARNING - could not keep a rollback copy (ESP full?); continuing" >&2
            fi
        fi
        mv -f "$GRUB.maze-signed" "$GRUB"
        printf '%s\n' "$TARGET_KVER" > "$GRUB.maze-kver" 2>/dev/null || true
        printf '%s\n' "$UKI_SUM" > "$GRUB_SRC" 2>/dev/null || true
        sync
        echo "maze-sb-sign: SIGNED $GRUB (from $UKI, kernel $TARGET_KVER)"
    else
        rm -f "$GRUB.maze-signed"
        [ -z "$_strip_tmp" ] || rm -f "$_strip_tmp"
        echo "maze-sb-sign: FAIL signing $UKI as $GRUB" >&2
        [ -n "$_sberr" ] && printf '%s\n' "$_sberr" | sed 's/^/maze-sb-sign:   /' >&2
        status_ok=0
    fi
elif [ -n "$TARGET_KVER" ]; then
    # Deliberately NOT falling back to "sign whatever grubx64.efi is already
    # there" (what this branch used to do): that is what let a dead kernel stay
    # installed as the boot image while the run still reported success. Leave
    # the existing chain untouched — it may still be bootable — and fail loudly.
    # "No UKI" includes "a UKI nobody vouched for" (see find_uki): rebuilding
    # through kernel-install records the new build, so the same fix covers both.
    echo "maze-sb-sign: ERROR - no trusted UKI on the ESP for the installed kernel $TARGET_KVER" >&2
    echo "maze-sb-sign:         REFUSING to install a stale grubx64.efi (that is what bricks the boot)." >&2
    echo "maze-sb-sign:         Your current grubx64.efi was left as it is. Rebuild the UKI with:" >&2
    echo "maze-sb-sign:           kernel-install add $TARGET_KVER /usr/lib/modules/$TARGET_KVER/vmlinuz" >&2
    status_ok=0
fi

# Second pass: covers the first-ever run, where there was no grubx64.efi yet for
# the pre-sign prune to lean on.
if [ "$status_ok" = 1 ]; then
    prune_stale_ukis
fi

# A rollback copy is only a way back while its kernel is installed. Once that
# kernel's modules are gone (upgraded or removed) the copy boots into a system
# that cannot load a single module, so drop it — together with its label —
# instead of offering it below and in maze-doctor. An unlabelled copy cannot be
# verified either, so it goes too.
if [ -e "$GRUB.maze-prev" ]; then
    _pv=""
    if [ -r "$GRUB.maze-prev.kver" ]; then
        _pv="$(tr -d '[:space:]' < "$GRUB.maze-prev.kver" 2>/dev/null || true)"
    fi
    if [ -z "$_pv" ] || [ ! -f "/usr/lib/modules/$_pv/vmlinuz" ]; then
        rm -f "$GRUB.maze-prev" "$GRUB.maze-prev.kver" 2>/dev/null || true
        echo "maze-sb-sign: removed rollback copy ${GRUB}.maze-prev${_pv:+ (kernel $_pv is no longer installed)}"
    fi
fi

# Also sign any loose kernels/UKIs on the ESP as a safety net (in case the
# firmware boots via a different path). These are NOT the primary boot path —
# the UKI as grubx64.efi is — but keeping them signed is harmless.
boot_path="$(bootctl --print-boot-path 2>/dev/null || true)"
dirs="$ESP"
for d in "$boot_path" /boot /efi; do
    [ -n "$d" ] || continue
    [ -d "$d" ] || continue
    case " $dirs " in *" $d "*) ;; *) dirs="$dirs $d" ;; esac
done
# Loose /boot/vmlinuz-<pkgbase> files are written by mkinitcpio's pacman hook
# on every kernel install/upgrade even though Maze's presets are empty: with
# layout=uki nothing ever boots them (there are no BLS entries pointing at them),
# so they are 16 MB of dead weight per kernel that this loop then dutifully
# signed. Remove them instead — but only in the configuration where they are
# provably unused: kernel-install layout=uki AND no loader/entries/*.conf on
# that ESP. Anything else keeps the old behaviour (sign, do not touch).
_uki_only=0
grep -qE '^[[:space:]]*layout=uki' /etc/kernel/install.conf 2>/dev/null && _uki_only=1
for d in $dirs; do
    if [ "$_uki_only" = 1 ] && ! ls "$d"/loader/entries/*.conf >/dev/null 2>&1; then
        for f in "$d"/vmlinuz-*; do
            [ -f "$f" ] || continue
            rm -f "$f" && echo "maze-sb-sign: removed loose ${f##*/} (unused with layout=uki; the UKI carries the kernel)"
        done
    else
        for f in "$d"/vmlinuz-*; do sign_loose_kernel "$f"; done
    fi
    # Same rules as the main pass: UKIs only if vouched for, loose kernels only
    # if identical to an installed one.
    for f in "$d"/EFI/Linux/*.efi; do
        sign_uki "$f"
    done
    for f in "$d"/*/*/linux; do
        sign_loose_kernel "$f"
    done
done

if [ "$refused_any" = 1 ]; then
    echo "maze-sb-sign: NOTE - some boot files were NOT signed (see REFUSED above). They were not" >&2
    echo "maze-sb-sign:   built by kernel-install on this machine, or were changed afterwards, so" >&2
    echo "maze-sb-sign:   Secure Boot will not run them. Nothing was deleted. If you did not put them" >&2
    echo "maze-sb-sign:   there, someone with access to the disk may have. To rebuild a kernel's UKI:" >&2
    echo "maze-sb-sign:     sudo maze-initramfs-rebuild" >&2
fi

# --- A second, firmware-selectable boot entry for the other kernel ----------
#
# THE PROBLEM THIS SOLVES
#
# maze-meta installs linux-lts alongside linux precisely so a bad mainline
# update is not a live-USB recovery. Its UKI is built, its DKMS modules are
# compiled, and the loop above signs it — and until now none of that could be
# reached. shim chainloads exactly one file, $ESP/EFI/BOOT/grubx64.efi, there is
# no boot menu, and firmware cannot load a MOK-signed image directly (shim is
# what validates MOK, not the firmware db). So the recovery kernel was insurance
# that could not be cashed.
#
# THE FIX
#
# shim looks for its second stage in ITS OWN directory. So a second copy of shim
# in $ESP/EFI/maze-recovery, next to a copy of the other kernel's signed UKI
# named grubx64.efi, is a complete second chain. MOK enrolment lives in a UEFI
# variable shared by every shim instance, so nothing has to be re-enrolled.
#
# The primary chain is not touched. If anything here fails or the image is
# corrupt, a normal boot is completely unaffected — which is why every failure
# below is a warning and never sets status_ok=0.

RECOVERY_DIR="$ESP/EFI/maze-recovery"
RECOVERY_IMG="$RECOVERY_DIR/grubx64.efi"
RECOVERY_LABEL="Maze Linux (recovery kernel)"

# The kernel to keep as recovery: linux-lts if it is installed, otherwise any
# other installed kernel that is not the one we just made the boot default.
# Never the boot kernel itself — a copy of the image that just broke is not a
# recovery path.
recovery_kver() {
    _lts="$(kver_for_pkgbase linux-lts || true)"
    if [ -n "$_lts" ] && [ "$_lts" != "$TARGET_KVER" ]; then
        printf '%s\n' "$_lts"
        return 0
    fi
    for _d in /usr/lib/modules/*/; do
        [ -f "${_d}vmlinuz" ] || continue
        _k="${_d%/}"; _k="${_k##*/}"
        [ "$_k" = "$TARGET_KVER" ] && continue
        printf '%s\n' "$_k"
        return 0
    done
    return 1
}

# Free space on the ESP in KiB, or empty when it cannot be read.
esp_free_kb() {
    df -Pk "$ESP" 2>/dev/null | awk 'NR==2 {print $4}'
}

install_recovery() {
    _rk="$(recovery_kver || true)"
    if [ -z "$_rk" ]; then
        # One kernel installed is a supported configuration, just a thinner one.
        [ -d "$RECOVERY_DIR" ] && rm -rf "$RECOVERY_DIR"
        return 0
    fi

    _ruki="$(find_uki "$_rk" || true)"
    if [ -z "$_ruki" ]; then
        echo "maze-sb-sign: WARNING - recovery kernel $_rk has no UKI on the ESP; no recovery entry" >&2
        return 0
    fi

    # It has to be signed, or shim refuses it and the entry is a dead end that
    # only reveals itself the day someone needs it.
    if ! sbverify --cert "$CRT" "$_ruki" >/dev/null 2>&1; then
        echo "maze-sb-sign: WARNING - recovery UKI $_ruki is not signed; no recovery entry" >&2
        return 0
    fi

    # Already current? Then this run costs nothing. Checked by version marker
    # first (cheap) and confirmed by content, so a half-written image from an
    # interrupted run is replaced rather than trusted.
    _marker="$RECOVERY_DIR/.maze-kver"
    if [ -s "$RECOVERY_IMG" ] && [ -r "$_marker" ] \
       && [ "$(tr -d '[:space:]' < "$_marker" 2>/dev/null || true)" = "$_rk" ] \
       && cmp -s "$_ruki" "$RECOVERY_IMG"; then
        echo "maze-sb-sign: OK     recovery entry (kernel $_rk)"
        return 0
    fi

    # Refuse if the copy cannot fit with room to spare. Filling the ESP is
    # exactly how the PRIMARY chain fails to be written on the next kernel
    # update, and a recovery image is never worth that risk — so the headroom
    # demanded is not just this copy but another whole UKI on top of it, which
    # is what the next `pacman -Syu` will need. When the ESP is tight the right
    # outcome is no recovery entry, not a boot that cannot be updated.
    _uki_kb="$(( $(wc -c < "$_ruki") / 1024 ))"
    _need_kb="$(( _uki_kb * 2 + 51200 ))"
    _free_kb="$(esp_free_kb)"
    if [ -n "$_free_kb" ] && [ "$_free_kb" -lt "$_need_kb" ]; then
        echo "maze-sb-sign: WARNING - not enough ESP space for a recovery entry" >&2
        echo "maze-sb-sign:           (need ~$(( _need_kb / 1024 )) MB, have $(( _free_kb / 1024 )) MB)" >&2
        return 0
    fi

    mkdir -p "$RECOVERY_DIR" || { echo "maze-sb-sign: WARNING - cannot create $RECOVERY_DIR" >&2; return 0; }
    # The LAST KNOWN GOOD shim, never one on trial: this chain is the way back
    # when a new shim in EFI/BOOT does not boot (see "Which shim goes on the ESP").
    install_atomic "$SHIM_LKG" "$RECOVERY_DIR/BOOTX64.EFI" || true
    install_atomic "$MM_LKG"   "$RECOVERY_DIR/mmx64.efi"   || true

    # Temp file and rename, for the same reason as grubx64.efi: a truncated
    # image that looks bootable is worse than no image at all.
    if cp -f "$_ruki" "$RECOVERY_IMG.new" 2>/dev/null \
       && mv -f "$RECOVERY_IMG.new" "$RECOVERY_IMG" 2>/dev/null; then
        printf '%s\n' "$_rk" > "$_marker" 2>/dev/null || true
        sync
        echo "maze-sb-sign: SIGNED $RECOVERY_IMG (recovery kernel $_rk)"
    else
        rm -f "$RECOVERY_IMG.new"
        echo "maze-sb-sign: WARNING - could not write the recovery image" >&2
    fi
    return 0
}

# The firmware entry that makes the above selectable. Written ONCE and then only
# checked: NVRAM has a finite number of writes and some firmware handles churn
# badly, so this must not run on every kernel update.
#
# BootOrder is the dangerous part. `efibootmgr --create` puts the new entry
# FIRST, which would silently make the recovery kernel the default boot. So the
# original order is captured, and afterwards restored with the new entry
# appended at the end — present in the firmware's boot menu, never ahead of the
# real one.
#   ensure_nvram_entry LABEL LOADER FILE
# LABEL is matched literally, so no label may be a substring of another one.
ensure_nvram_entry() {
    _ne_label="$1"; _ne_loader="$2"; _ne_file="$3"
    [ -s "$_ne_file" ] || return 0
    command -v efibootmgr >/dev/null 2>&1 || return 0
    [ -d /sys/firmware/efi/efivars ] || return 0

    if efibootmgr 2>/dev/null | grep -Fq "$_ne_label"; then
        return 0
    fi

    # Which disk and partition the ESP lives on.
    _src="$(findmnt -no SOURCE --target "$ESP" 2>/dev/null || true)"
    [ -n "$_src" ] || return 0
    _partn="$(lsblk -no PARTN "$_src" 2>/dev/null | tr -d '[:space:]' || true)"
    _disk="$(lsblk -no PKNAME "$_src" 2>/dev/null | head -n 1 | tr -d '[:space:]' || true)"
    if [ -z "$_partn" ] || [ -z "$_disk" ]; then
        echo "maze-sb-sign: WARNING - could not identify the ESP disk; no \"$_ne_label\" boot entry" >&2
        return 0
    fi

    _before="$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p' | tr -d '[:space:]' || true)"

    if ! efibootmgr --quiet --create \
            --disk "/dev/$_disk" --part "$_partn" \
            --loader "$_ne_loader" \
            --label "$_ne_label" >/dev/null 2>&1; then
        echo "maze-sb-sign: WARNING - could not create the \"$_ne_label\" boot entry" >&2
        return 0
    fi

    # Put the order back, with the new entry last.
    _after="$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p' | tr -d '[:space:]' || true)"
    if [ -n "$_before" ] && [ -n "$_after" ]; then
        # Everything that was not in the order before is new; it all goes to the
        # end, in the order the firmware reported it. Written as an accumulator
        # rather than a single assignment so that more than one new entry cannot
        # silently drop all but the last.
        _added=""
        for _e in $(printf '%s' "$_after" | tr ',' ' '); do
            case ",$_before," in
                *",$_e,"*) ;;
                *) _added="${_added:+$_added,}$_e" ;;
            esac
        done
        _new="$_before${_added:+,$_added}"
        if [ "$_new" != "$_after" ]; then
            efibootmgr --quiet --bootorder "$_new" >/dev/null 2>&1 \
                || echo "maze-sb-sign: WARNING - \"$_ne_label\" entry created but BootOrder not restored" >&2
        fi
    fi
    echo "maze-sb-sign: created firmware boot entry \"$_ne_label\""
    return 0
}

# --- Last resort: boot WITHOUT shim, with Secure Boot disabled ---------------
#
# Every entry above goes through shim. Shim is a third-party binary that can
# stop working on its own: an SBAT/dbx revocation pushed by a firmware or
# fwupd update, a corrupt copy on the ESP, a firmware that rejects it. When it
# does, the kernels and the signed UKIs are all still fine — there is simply
# nothing left that loads them, and "turn Secure Boot off" does not help,
# because every NVRAM entry still points at the broken shim.
#
# A UKI is itself a complete EFI application (systemd-stub + kernel + initrd +
# cmdline), so the firmware can start it directly. These entries do exactly
# that, pointing at the SAME files shim chainloads — no extra copy on the ESP,
# and they follow every kernel update automatically because grubx64.efi is
# always replaced in place under the same name.
#
# With Secure Boot ON the firmware refuses them (the MOK key is not in db) and
# moves on to the next entry; they sit at the END of BootOrder, so they are
# never tried before the real chain. With Secure Boot OFF they always boot.
# Recovery procedure if shim ever breaks: firmware setup -> Secure Boot ->
# Disabled -> boot menu (F11/F12/Esc) -> "Maze Linux (no shim, Secure Boot off)".
DIRECT_LABEL="Maze Linux (no shim, Secure Boot off)"
DIRECT_RECOVERY_LABEL="Maze Linux (recovery kernel, no shim)"

install_recovery
ensure_nvram_entry "$RECOVERY_LABEL" '\EFI\maze-recovery\BOOTX64.EFI' "$RECOVERY_IMG"
ensure_nvram_entry "$DIRECT_LABEL" '\EFI\BOOT\grubx64.efi' "$GRUB"
ensure_nvram_entry "$DIRECT_RECOVERY_LABEL" '\EFI\maze-recovery\grubx64.efi' "$RECOVERY_IMG"

if [ "$status_ok" = 1 ]; then
    # Point at the rollback copy while the user can still read it. It is the only
    # way back to the previous kernel on a shim -> grubx64.efi chain with no boot
    # menu, and it is useless if nobody knows it is there.
    if [ -s "$GRUB.maze-prev" ]; then
        _pk=""
        if [ -r "$GRUB.maze-prev.kver" ]; then
            _pk="$(tr -d '[:space:]' < "$GRUB.maze-prev.kver" 2>/dev/null || true)"
        fi
        echo "maze-sb-sign: rollback available${_pk:+ (kernel $_pk)}: restore with"
        echo "maze-sb-sign:   cp -f ${GRUB}.maze-prev ${GRUB}"
    fi
    echo "maze-sb-sign: done (ESP=$ESP)"
else
    echo "maze-sb-sign: WARNING - some boot files are NOT validly signed (ESP=$ESP)" >&2
    exit 1
fi
