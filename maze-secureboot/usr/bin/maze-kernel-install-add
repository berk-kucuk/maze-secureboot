#!/bin/sh
# Managed by Maze Linux. Invoked by the 85-maze-kernel-install.hook pacman hook
# (NeedsTargets) and runs `kernel-install add`, so layout=uki actually rebuilds
# the Unified Kernel Image on the ESP — mkinitcpio's own preset-driven pacman
# hook does nothing on Maze (the presets are empty by design).
#
# Reads the hook's targets from stdin, one per line:
#   usr/lib/modules/<kver>/vmlinuz   -> rebuild that kernel
#   anything else (a path that goes into the initramfs, a microcode image, the
#   stub, or the mkinitcpio package name) -> rebuild EVERY installed kernel,
#   because every UKI carries its own copy of it.
set -u

kvers=""
all=0
while IFS= read -r f; do
    case "$f" in
        usr/lib/modules/*/vmlinuz)
            k="${f#usr/lib/modules/}"; k="${k%/vmlinuz}"
            case " $kvers " in *" $k "*) ;; *) kvers="$kvers $k" ;; esac
            ;;
        "") ;;
        *) all=1 ;;
    esac
done

if [ "$all" = 1 ]; then
    # Installed kernels, enumerated the way maze-initramfs-rebuild does: a
    # directory counts only with both pkgbase and vmlinuz — bare trees left by
    # a removed kernel's DKMS modules must not get a UKI.
    kvers=""
    for d in /usr/lib/modules/*/; do
        [ -f "${d}pkgbase" ] && [ -f "${d}vmlinuz" ] || continue
        k="${d%/}"; kvers="$kvers ${k##*/}"
    done
    [ -n "$kvers" ] && echo "maze-kernel-install-add: boot-image contents changed — rebuilding the UKI for:$kvers"
fi

rc=0
for kver in $kvers; do
    [ -f "/usr/lib/modules/$kver/vmlinuz" ] || continue
    if ! kernel-install add "$kver" "/usr/lib/modules/$kver/vmlinuz"; then
        rc=1
        echo "maze-kernel-install-add: ERROR - kernel-install add FAILED for $kver" >&2
        echo "maze-kernel-install-add:   The UKI on the ESP was NOT rebuilt. If this was a kernel" >&2
        echo "maze-kernel-install-add:   upgrade, the machine still boots the PREVIOUS kernel — whose" >&2
        echo "maze-kernel-install-add:   modules this upgrade just deleted. DO NOT REBOOT until fixed:" >&2
        echo "maze-kernel-install-add:     sudo kernel-install add $kver /usr/lib/modules/$kver/vmlinuz" >&2
        echo "maze-kernel-install-add:     sudo maze-sb-sign --force-bootloader" >&2
    fi
done
# Exit non-zero so pacman reports the hook as failed. This used to swallow the
# failure (echo, then exit 0): the one moment the user could still have fixed
# things — still booted, still root, mid-transaction — passed with nothing but a
# line lost in the upgrade scroll, and the machine died on the next reboot.
exit "$rc"
